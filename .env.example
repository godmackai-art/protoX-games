# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Server-side Stripe secret key for processing support payments ($1, $5, $10, $100).
STRIPE_SECRET_KEY=""

# STRIPE_PRODUCT_ID: Stripe Product ID (e.g. prod_xxxxxxxxxxxxxx) used to process $1, $5, $10, and $100 support receipts.
STRIPE_PRODUCT_ID=""

# Optional tier-specific Stripe Product IDs (fall back to STRIPE_PRODUCT_ID if unset):
# STRIPE_PRODUCT_ID_1=""
# STRIPE_PRODUCT_ID_5=""
# STRIPE_PRODUCT_ID_10=""
# STRIPE_PRODUCT_ID_100=""
